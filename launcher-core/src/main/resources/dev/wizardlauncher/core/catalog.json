{
  "schema_version": 2,
  "_comment": "What the launcher installs and how it runs it. A newer catalog can be dropped into the data folder as catalog.json + catalog.json.sig; it is only used if the Ed25519 signature verifies against signing.public_key below.",

  "minecraft": {
    "client_version": "1.20.1",
    "server_version": "1.16.5",
    "fabric_loader_fallback": "0.15.11",
    "required_java_major": 17
  },

  "server": {
    "_mode_comment": "hosted = world server and ViaProxy share one JVM (dev.wizardlauncher.host.ServerHost). split = the 1.x layout, two JVMs; kept as a fallback.",
